{
 "about": "OMOP vocabulary capture for RFC-016 step 4: every valid RxNorm / RxNorm Extension Dose Form with its 'Has route of admin' target (null when it has none), and each target route concept with its concept_ancestor ancestors (itself included). Read-only SELECTs.",
 "schema": "synthea23m",
 "captured": "2026-10-12",
 "formsSql": "SELECT f.concept_id, f.vocabulary_id, f.concept_name, r.concept_id_2\n  FROM synthea23m.concept f\n  LEFT JOIN synthea23m.concept_relationship r\n    ON r.concept_id_1 = f.concept_id AND r.relationship_id = 'Has route of admin' AND r.invalid_reason IS NULL\n WHERE f.concept_class_id = 'Dose Form' AND f.vocabulary_id IN ('RxNorm', 'RxNorm Extension')\n   AND f.invalid_reason IS NULL\n ORDER BY f.concept_id",
 "routesSql": "SELECT c.concept_id, c.concept_name, c.vocabulary_id, c.domain_id,\n       ARRAY(SELECT ca.ancestor_concept_id FROM synthea23m.concept_ancestor ca\n              WHERE ca.descendant_concept_id = c.concept_id ORDER BY 1)\n  FROM synthea23m.concept c WHERE c.concept_id = ANY(%s) ORDER BY 1",
